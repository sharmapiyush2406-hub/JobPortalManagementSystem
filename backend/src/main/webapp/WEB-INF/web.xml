<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Job Portal Management System</display-name>
    <description>Core Java Full Stack Job Portal with Servlets and JDBC</description>

    <!-- ============================================== -->
    <!-- 1. CORS FILTER (Global for React Integration)   -->
    <!-- ============================================== -->
    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>com.jobportal.filter.CorsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ============================================== -->
    <!-- 2. AUTHENTICATION & ROLE FILTERS               -->
    <!-- ============================================== -->
    <filter>
        <filter-name>CandidateAuthFilter</filter-name>
        <filter-class>com.jobportal.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CandidateAuthFilter</filter-name>
        <url-pattern>/api/candidate/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AdminAuthFilter</filter-name>
        <filter-class>com.jobportal.filter.AdminFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminAuthFilter</filter-name>
        <url-pattern>/api/admin/*</url-pattern>
    </filter-mapping>

    <!-- ============================================== -->
    <!-- 3. SERVLET DEFINITIONS                         -->
    <!-- ============================================== -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.jobportal.servlet.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/api/auth/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>JobServlet</servlet-name>
        <servlet-class>com.jobportal.servlet.JobServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>JobServlet</servlet-name>
        <url-pattern>/api/jobs/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApplicationServlet</servlet-name>
        <servlet-class>com.jobportal.servlet.ApplicationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApplicationServlet</servlet-name>
        <url-pattern>/api/applications/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CandidateServlet</servlet-name>
        <servlet-class>com.jobportal.servlet.CandidateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CandidateServlet</servlet-name>
        <url-pattern>/api/candidate/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>com.jobportal.servlet.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/api/admin/*</url-pattern>
    </servlet-mapping>

    <!-- ============================================== -->
    <!-- 4. SESSION CONFIGURATION                       -->
    <!-- ============================================== -->
    <session-config>
        <session-timeout>120</session-timeout> <!-- 2 hours -->
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure> <!-- set to false for local HTTP dev -->
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Welcome File -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>
