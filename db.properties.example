# ========================================================
# Job Portal Management System - Database Configuration Template
# ========================================================
# For Render deployment, configure environment variables:
#   DB_URL, DB_USER, DB_PASSWORD
#
# For local development, copy this file to db.properties:
#   db.url=jdbc:mysql://localhost:3306/job_portal?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
#   db.user=root
#   db.password=your_local_password
